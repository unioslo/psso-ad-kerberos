<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Windows-only: the enrollment logic uses the CertEnroll / CertCli COM APIs, which exist
         only on Windows. net8.0-windows pins that and enables COM interop. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EnrollmentAgent</RootNamespace>
    <!-- Required to call the CertEnroll COM objects via late binding (dynamic). -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Client-certificate (mutual TLS) authentication is not in the Web SDK by default. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" Version="8.0.10" />
  </ItemGroup>

</Project>
